        dicePool: { formula: 'Manipulación + Medicina', difficulty: 7 },
        cost: { resource: 'Sangre', amount: 2 },
        actionType: 'instant',
        duration: 'turnos según éxitos',
        tags: ['extinción', 'veneno', 'distancia', 'agravado', 'assamita'],
