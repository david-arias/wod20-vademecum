  },

  // ── PROTEAN (Niveles 1-9) ─────────────────────────────────────────────────
  {
    id: 'protean',
    name: 'Protean',
    gameSystem: 'V20',
    categoryType: 'discipline',
    description: 'La metamorfosis física vampírica por excelencia, disciplina ancestral de los Gangrel. El Protean permite transformar el cuerpo en formas animales, fundirse con la tierra y, en su cima, acceder a estados de existencia casi incorpóreos.',
    icon: 'refresh-cw',
