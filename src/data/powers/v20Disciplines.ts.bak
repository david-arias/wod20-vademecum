          },
        ],
      },
      // ── SENDA DEL TESTIGO ────────────────────────────────────────────────────
      {
        id: 'senda-del-testigo',
        name: 'Senda del Testigo',
        isPrimary: false,
        description: 'La senda de la memoria y el testimonio de los muertos. Donde otras sendas manipulan la muerte como fuerza o como ser, la Senda del Testigo la usa como archivo: los restos y lugares guardan impresiones del pasado, y el nigromante aprende a leerlas con una fidelidad sobrenatural que convierte cada cadáver en una cámara de grabación.',
        levels: [
          {
            level: 1,
            name: 'Eco del Difunto',
            summary: 'Los restos o pertenencias del fallecido emiten un "eco" de sus últimas emociones e impresiones.',
            systemText: 'Con contacto físico con restos corporales (huesos, cenizas, tejido preservado) o con un objeto fuertemente ligado emocionalmente al difunto, el Giovanni recibe impresiones sensoriales y emocionales de los últimos momentos de vida de esa persona. 1 éxito: emoción dominante en el momento de la muerte (miedo, paz, rabia, confusión). 2-3 éxitos: imagen fugaz del entorno inmediato y la causa de la muerte. 4-5 éxitos: secuencia coherente de los últimos 5-10 minutos de vida, con imágenes, sonidos y sensaciones corporales. Esta información es involuntaria —son los últimos ecos grabados en la materia, no una comunicación activa del alma. El poder no requiere que el alma esté presente o que el difunto haya sido digno de recordar. Tirada: Percepción + Ocultismo dif. 5.',
            dicePool: { formula: 'Percepción + Ocultismo', difficulty: 5 },
            cost: { resource: 'Gratis', amount: 'free' },
            actionType: 'instant',
            duration: 'instantáneo',
            tags: ['memoria', 'restos', 'pasado', 'psicometría'],
          },
          {
            level: 2,
            name: 'Leer los Huesos',
            summary: 'Los restos corporales revelan la historia de vida completa de su dueño.',
            systemText: 'Con el nivel anterior el Giovanni lee los últimos momentos; con este nivel lee la vida entera. Mediante contacto sostenido con restos físicos (al menos fragmentos de hueso, no solo cabello u objetos), el nigromante accede a un resumen biográfico del difunto: edad aproximada al morir, traumas físicos y enfermedades crónicas sufridas en vida, ocupación principal (las actividades repetidas dejan huellas en los huesos), causa de muerte con detalle, y tres o cuatro memorias emocionalmente cargadas del pasado (no necesariamente recientes). 5 éxitos permiten también acceder al nombre con que la persona era conocida. Este poder no funciona con restos de vampiros —la no-vida distorsiona el registro. Tirada: Inteligencia + Medicina dif. 6.',
            dicePool: { formula: 'Inteligencia + Medicina', difficulty: 6 },
            cost: { resource: 'Sangre', amount: 1 },
            actionType: 'extended',
            duration: 'instantáneo (visión)',
            tags: ['memoria', 'huesos', 'historia', 'forense'],
          },
          {
            level: 3,
            name: 'Interrogar al Difunto',
            summary: 'Fuerza al alma del difunto a responder preguntas, aunque no quiera comunicarse.',
            systemText: 'A diferencia de la Llamada del Alma (que invita), este poder coerciona. El Giovanni puede forzar al alma de un difunto —cuyo cuerpo o restos significativos estén presentes— a responder hasta (Nigromancia) preguntas directas. El alma no puede mentir pero puede omitir, matizar o responder con información incompleta (el poder compele a responder, no a revelar todo). Si el alma tiene Voluntad 8+, puede resistir respuestas específicamente traumáticas o que revelen a seres queridos: tirada enfrentada por cada respuesta resistida. Las preguntas deben formularse verbalmente. El alma siente esta coerción como humillante y puede albergar rencor eterno contra el nigromante (efectos narrativos a discreción del Narrador). Tirada: Manipulación + Ocultismo dif. 7.',
            dicePool: { formula: 'Manipulación + Ocultismo', difficulty: 7 },
            cost: { resource: 'Sangre', amount: 1 },
            actionType: 'extended',
            duration: '(Nigromancia) preguntas',
            tags: ['interrogar', 'alma', 'coerción', 'información'],
          },
          {
            level: 4,
            name: 'Memorias Completas',
            summary: 'Accede a la totalidad de los recuerdos del difunto como si fueran propios.',
            systemText: 'El Giovanni puede sumergirse en la memoria completa de un difunto cuyo alma ha sido convocada o cuyo cuerpo está presente. Durante la visión (que dura [éxitos] horas de tiempo real pero abarca toda una vida en la percepción del nigromante), el Giovanni experimenta los recuerdos del difunto desde su perspectiva en primera persona: idiomas que el difunto sabía, habilidades desarrolladas, contraseñas, nombres, secretos, traiciones. Esta inmersión es incapacitante —el Giovanni queda en trance durante el proceso. Mecánicamente, puede usar Habilidades del difunto a dif. +2 durante (éxitos) días después del acceso (como si las conociera vagamente). Riesgo: si el difunto sufrió traumas graves o vivió experiencias de extrema angustia, el Giovanni debe superar tirada de Humanidad/equivalente dif. 7 para no quedar perturbado. Tirada: Inteligencia + Empatía dif. 8.',
            dicePool: { formula: 'Inteligencia + Empatía', difficulty: 8 },
            cost: { resource: 'Sangre', amount: 2 },
            actionType: 'extended',
            duration: '(éxitos) horas de trance',
            tags: ['memoria', 'habilidades', 'trance', 'giovanni', 'inmersión'],
          },
          {
            level: 5,
            name: 'Archivo de los Siglos',
            summary: 'Accede a la cadena completa de testimonios: todos los que murieron en un lugar o todos los que usaron un objeto a lo largo de la historia.',
            systemText: 'La cumbre de la Senda del Testigo trasciende al individuo: el Giovanni puede leer no una vida, sino una cadena de vidas ligadas a un lugar o a un linaje de objetos. Activando el poder en un lugar con historia significativa de muertes (campo de batalla, cementerio, edificio antiguo, cámara de torturas), accede a testimonios encadenados: ve la muerte más reciente, y puede seguir el hilo hacia atrás tanto como los éxitos lo permitan (1 éxito = décadas; 3 éxitos = siglos; 5 éxitos = el momento fundacional del lugar, si la memoria espectral ha sobrevivido). También funciona sobre un objeto con historia larga —una espada, una joya familiar, un libro. El Giovanni puede "rebobinar" y "avanzar" en la cadena de memorias. El proceso tarda (alcance histórico elegido / 2) horas y requiere concentración absoluta. Tirada: Inteligencia + Ocultismo dif. 9.',
            dicePool: { formula: 'Inteligencia + Ocultismo', difficulty: 9 },
            cost: { resource: 'Sangre', amount: 3 },
            actionType: 'extended',
            duration: 'según alcance histórico',
            tags: ['memoria', 'historia', 'lugar', 'linaje', 'épico', 'giovanni'],
          },
        ],
      },
    ],
    levels: [],
  } as unknown as MultiPathDiscipline,

  // ── QUIMERISMO (Niveles 1-9) ────────────────────────────────────────────────
