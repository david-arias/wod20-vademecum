        dicePool: { formula: 'Manipulación + Ocultismo', difficulty: 9 },
        cost: { resource: 'Voluntad', amount: 1 },
        actionType: 'instant',
        duration: 'instantáneo',
        tags: ['daño-agravado', 'hervir-sangre', 'letal', 'combate', 'épico', 'sangre'],
